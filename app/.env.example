# Copy this file to `.env` and fill in from Supabase Settings -> API.
# These configure the dormant cloud client. The app stays local until the
# repository adapter is explicitly enabled and verified against your project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. Must be allow-listed in Supabase Auth -> URL Configuration.
# Leave blank to redirect to the current web app base URL.
VITE_AUTH_REDIRECT_URL=
